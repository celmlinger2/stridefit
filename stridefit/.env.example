# StrideFit environment variables.
# Copy this file to `.env.local` and fill in the values from your Supabase project:
# Supabase Dashboard -> Project Settings -> API
#
#   NEXT_PUBLIC_SUPABASE_URL = the "Project URL"
#   NEXT_PUBLIC_SUPABASE_ANON_KEY = the "anon public" key
#
# Never commit real credentials. Never use the service_role key in this app.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Used for OAuth redirects (Google sign-in). Set to your production URL on Vercel,
# e.g. https://stridefitapp.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
